<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of this app is copied by Android's backup or by moving to a new phone.
  The app keeps a device id, its own blocks of receipt numbers and unsent
  offline work. Copied to a second phone, both would print the same receipt
  numbers. The school's data lives on the server; a new phone signs in afresh.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
