{
  "name": "school-manager-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "The School Manager application (admin desktop + teacher web, one codebase, one Supabase database per school).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "harness": "vitest run --config vitest.harness.config.ts",
    "harness:node20": "node -e \"require('fs').writeFileSync('/tmp/no-ws.mjs','delete globalThis.WebSocket')\" && NODE_OPTIONS=\"--import file:///tmp/no-ws.mjs\" npm run harness"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.56.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^2.1.9"
  }
}
