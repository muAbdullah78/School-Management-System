# ---------------------------------------------------------------------------
# Deployment configuration.
#
# There is ONE Supabase project for every school, so these values are the same
# in every build. A school is identified by who logs in, not by which copy of
# the app they run. Copy this file to `.env` and fill it in once.
#
# See docs/SETUP.md for where to find these values.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon" public key. Safe to ship in the browser bundle: Row Level
# Security is what actually protects the data. Never put the service_role key
# here; it bypasses every rule.
VITE_SUPABASE_ANON_KEY=

# Placeholder name shown for the brief moment before the signed-in school's own
# settings load. The app title is composed as "{name} Manager".
VITE_SCHOOL_NAME=School

# The marketing site, WITHOUT a trailing slash, e.g. https://theschoolmanager.site
# Used by one link: "Back to the website" on the sign-in and signup screens.
# Leave it blank and that link points at the live domain by default.
VITE_SITE_URL=
