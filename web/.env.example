# ---------------------------------------------------------------------------
# Per-school configuration. Every school gets its OWN Supabase project, so
# these values are different for every deployment. Copy this file to `.env`
# and fill in the values from the school's Supabase project settings.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon" public key (safe to ship in the client; Row Level Security
# is what actually protects the data).
VITE_SUPABASE_ANON_KEY=

# Fallback school name used before the in-app School Settings row is filled.
# The app title is composed as "{name} Manager", e.g. "City Public School Manager".
VITE_SCHOOL_NAME=Your School
